<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ─── Project Identity ─────────────────────────────────────────────── -->
    <groupId>com.dyedurham</groupId>
    <artifactId>name-sorter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Name Sorter</name>
    <description>
        Sorts a list of names from a file by last name first, then by given names.
        Prints the sorted list to the console and writes it to sorted-names-list.txt.
    </description>

    <!-- ─── Java Version ─────────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions pinned here for easy upgrades -->
        <junit.version>5.10.0</junit.version>
        <assertj.version>3.24.2</assertj.version>
    </properties>

    <!-- ─── Dependencies ─────────────────────────────────────────────────── -->
    <dependencies>

        <!-- JUnit 5: Modern Java testing framework -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            AssertJ: Fluent assertion library.
            Produces human-readable test failure messages.
            Example: assertThat(result).containsExactly("Anna Smith", "Zoe Smith")
        -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ─── Build Plugins ────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!--
                maven-surefire-plugin: Required for Maven to discover and run
                JUnit 5 tests. Without this, 'mvn test' would not find them.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>

            <!--
                maven-shade-plugin: Packages all dependencies into a single
                executable "fat JAR". This allows running:
                    java -jar target/name-sorter-1.0.0.jar ./unsorted-names-list.txt
                without needing any classpath configuration.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <!-- Tells the JAR which class contains the main() method -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.dyedurham.namesorter.Main</mainClass>
                                </transformer>
                            </transformers>
                            <!-- Suppress the 'dependency-reduced-pom.xml' side file -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
